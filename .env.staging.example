# Patient Flow OS — STAGING environment template.
#
# Copy to .env.staging and fill in. Used by:
#   ./deploy.sh --staging --domain staging.api.myclinic.com
#
# Staging runs the SAME code and the SAME compose file as production, including
# NODE_ENV=production. That is the point: a migration or release rehearsed
# against a laxer configuration proves nothing about the one that will run in a
# clinic. Consequences worth knowing before you fill this in:
#
#   - The production config validator applies. A missing JWT_SECRET, or one
#     shorter than 32 characters, stops the process rather than warning.
#   - SEED_ON_START is refused. Staging cannot be populated with demo accounts;
#     load it from a restored production backup instead (see BACKUP_RECOVERY.md),
#     or create accounts through the admin API.
#   - The payment gateway and OTP provider will NOT fall back to fakes. Use
#     Razorpay TEST-mode keys and a real MSG91 key, or those flows will fail
#     closed — which is correct behaviour, not a bug to work around.
#
# SECRETS MUST DIFFER FROM PRODUCTION. Sharing JWT_SECRET would make a staging
# token valid in production; sharing database passwords defeats the isolation
# the separate volumes exist to provide.

DOMAIN=staging.api.example.com

# Distinct from production. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Distinct from production. Generate: openssl rand -hex 32
JWT_SECRET=
OTP_EXPIRY_SECONDS=300

# Never anything else here — the backend refuses to boot with SEED_ON_START=true
# under NODE_ENV=production, and staging is NODE_ENV=production.
SEED_ON_START=false

# Scrape token for /metrics. Use a different value from production so a leaked
# staging token cannot read production metrics.
METRICS_TOKEN=

# Where the desktop/mobile builds pointed at staging will connect from.
CORS_ORIGINS=https://staging.api.example.com,http://tauri.localhost,https://tauri.localhost

# ── Integrations ──────────────────────────────────────────────────────────
# Test-mode credentials. Leaving these blank does NOT give you a dev fallback
# here (NODE_ENV=production); the affected flow fails closed instead.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
INTEGRATIONS_TEST_MOBILE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
NOTIFY_APPROACHING_AHEAD=3
NOTIFY_ARRIVAL_AHEAD=1

VOICE_INTERNAL_SECRET=
